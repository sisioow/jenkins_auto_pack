{
  "jenkins": {
    "base_url": "http://172.16.201.73:8080/jenkins/",
    "username_env": "JENKINS_USERNAME",
    "password_env": "JENKINS_PASSWORD"
  },
  "browser": {
    "channel": "chrome",
    "user_data_dir": ".playwright_profile",
    "manual_login_if_needed": true,
    "manual_login_timeout_ms": 180000,
    "keep_open_after_build": true
  },
