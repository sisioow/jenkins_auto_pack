    "pure_a": "纯a打包",
    "mixed_or_b": "混淆2-自动换分支"
  },
  "parameter_defaults": {
    "BUILD_TYPE": "release",
    "PACKAGE_TYPE": "market",
    "init_ks_sdk_when_lock": "0",
    "junkcode": "false",
    "enableProguard": "false",
    "lib_a_include_switch": "1",
    "use_a_launch_theme": "false",
    "use_cocos_a": "false",
    "market_channel_ui": "default"
  },
  "branch_parameter": {
    "name": "BRANCH",
    "fill_mode": "pinyin_search"
  },
  "playwright_timeout_ms": 15000
